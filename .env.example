# Copy to .env and fill in what you want. Everything is optional.

# --- Overlay -------------------------------------------------------------
# D3H_OVERLAY=1            # 0 = dashboard + F9 snapshots only
# D3H_HOVER_MS=350         # how long the mouse rests on an item before reading it
# D3H_OCR_SCALE=1.0        # try 1.5 if item names/stats are misread
# D3H_CARD_POS=auto        # or a fixed spot like 40,40
# D3H_REQUIRE_GAME=1       # only read while the Diablo III window is focused
# D3H_DEBUG=0              # 1 = save what the overlay saw to data\debug
# D3H_KEY_TOGGLE=<f8>
# D3H_HOTKEY=<f9>          # snapshot / ask Claude
# D3H_KEY_SAVE=<f10>
# D3H_KEY_EQUIP=<f11>

# --- Claude reads tooltips (F9). Costs a few cents per read. --------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# 1 = also read dashboard snapshots automatically
D3H_AUTO_READ=0

# --- Import equipped gear from Blizzard (free) ----------------------------
# https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us

# D3H_PORT=5173
