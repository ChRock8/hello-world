# Copy to .env and fill in what you want. Everything is optional.

# Read item tooltips from screenshots (costs a few cents per read).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# 1 = read every F9 snapshot automatically; 0 = only when you click "Read".
D3H_AUTO_READ=0

# Import equipped gear from Blizzard (free): https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us

# D3H_HOTKEY=<f9>
# D3H_PORT=5173
# D3H_BUILD=ww_rend_barb
